{
  "name": "web-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "Live chat for a website: widget, web inbox, iPhone app, on AWS serverless.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test aws/chat/test/*.test.mjs",
    "dev": "node tools/chat-dev.mjs",
    "dev:dynamo": "node tools/chat-dev.mjs --dynamo",
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "smoke": "node tools/smoke.mjs",
    "check:public": "bash tools/check-public.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
