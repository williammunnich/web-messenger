# Copy to deploy.env (gitignored) and fill in. docs/deploy.md explains each value.

# Required
ALLOWED_EMAIL=you@example.com          # the one Google account allowed into the inbox and the app
GOOGLE_CLIENT_ID=                      # filled in during step 2 of docs/deploy.md
# Sites allowed to open the chat and to call /visitor/data and /visitor/forget (exact origins, comma-separated, no paths).
# Every site that embeds the widget must be listed, for example a second site: ...,https://shop.example.com
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Usually fine as they are
PREFIX=messenger                       # names the stack, table, function and SSM path
REGION=us-east-1
OWNER_NAME="Support"                   # the name visitors see
SITE_URL=https://example.com

# iPhone push notifications (leave empty to skip)
APNS_TEAM_ID=                          # your Apple team id
APNS_TOPIC=                            # the app's bundle id, same as APP_BUNDLE_ID in ios/Local.xcconfig

# Your own hostnames (optional). Without them you get long amazonaws.com addresses, which work fine.
CHAT_DOMAIN=                           # e.g. chat.example.com
INBOX_DOMAIN=                          # e.g. inbox.example.com
CERT_ARN=                              # ACM certificate in REGION covering both
HOSTED_ZONE_ID=                        # if set, the DNS records are written to this Route 53 zone

# Email into the inbox (optional, docs/deploy.md step 7)
MAIL_ADDRESS=                          # e.g. info@example.com
FROM_ADDRESS=                          # e.g. "Your Name <info@example.com>"
